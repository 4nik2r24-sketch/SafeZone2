<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E18"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Botón para Volver -->
    <TextView
        android:id="@+id/btnVolverContactos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Volver al Mapa"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:padding="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contactos de Emergencia"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Se notificará a estas personas si entras a una zona de riesgo."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <!-- Formulario para agregar contacto -->
    <EditText
        android:id="@+id/etNombreContacto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#171B26"
        android:hint="Nombre del familiar o amigo"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTelefonoContacto"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#171B26"
        android:hint="Número de teléfono"
        android:inputType="phone"
        android:textColorHint="#475569"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGuardarContacto"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#38BDF8"
        android:text="Agregar Contacto"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Aquí iría una lista (RecyclerView) con los contactos guardados, por ahora un placeholder -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tienes contactos agregados aún."
        android:textColor="#475569"
        android:textAlignment="center"
        android:layout_marginTop="30dp"/>

</LinearLayout>